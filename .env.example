# ramani local environment
# copy this file to .env and fill it in. .env is gitignored.

# supabase project that hosts the edge function
SUPABASE_URL=https://your-project-ref.supabase.co

# the anon key. this one is public by design, it ships in the page.
# find it under project settings, api keys, anon public.
SUPABASE_ANON_KEY=your-anon-public-key

# the edge function name
CHAT_FUNCTION=ramani-chat

# the model key. this one is secret and belongs in supabase secrets only.
# never commit it, never put it in _config.yml.
#   supabase secrets set DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_KEY=

# optional
DEEPSEEK_MODEL=deepseek-chat
ALLOWED_ORIGIN=*
